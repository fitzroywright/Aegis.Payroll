{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "CommonSecrets": {
    "Mode": "Production",
    "WorkloadName": "Aegis.Payroll",
    "ProviderOrder": [
      "PrimarySecrets"
    ],
    "Providers": {
      "PrimarySecrets": {
        "Type": "OpenBao",
        "Settings": {
          "Enabled": true,
          "Address": "",
          "RequireHttps": true,
          "BasePath": "aegis/payroll",
          "RequireSecretIdFileInProduction": true
        }
      }
    }
  },
  "Security": {
    "Mode": "ActiveDirectory",
    "ActiveDirectory": {
      "Domain": "fftpj.local",
      "SearchBase": "DC=fftpj,DC=local",
      "Servers": [
        "JMAD01.fftpj.local",
        "JMAD02.fftpj.local"
      ],
      "Port": 636,
      "AdministrativeGroups": []
    },
    "UserRoles": {},
    "GroupRoles": {},
    "Mock": {
      "AllowedUsers": "payroll-dev",
      "PasswordSecretName": "payroll/mock-password"
    }
  },
  "Database": {
    "ConnectionSecretName": "payroll/database"
  },
  "Storage": {
    "Provider": "LocalFolder",
    "Local": {
      "RootPath": "data/documents"
    }
  },
  "Messaging": {
    "QueuePath": "data/messaging",
    "Microsoft365": {
      "Enabled": false,
      "TenantId": "",
      "ClientId": "",
      "SenderUpn": "",
      "ClientSecretName": "payroll/microsoft365-client-secret"
    }
  },
  "Aegis": {
    "PublicUrl": "",
    "Configuration": {
      "Url": ""
    },
    "Registration": {
      "InstanceId": "",
      "IdentityFile": "data/registration-identity.json"
    }
  }
}
